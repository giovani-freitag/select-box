                    "jsonpath": "$.version"
                },
                {
                    "type": "json",
                    "path": "packages/styles/package.json",
                    "jsonpath": "$.version"
                },
                {
                    "type": "json",
                    "path": "packages/vue/package.json",
                    "jsonpath": "$.version"
                },
                {
                    "type": "json",
                    "path": "packages/webcomponents/package.json",
                    "jsonpath": "$.version"
                }
            ]
        }
    }
}
