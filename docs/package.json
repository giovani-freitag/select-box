{
    "name": "@select-box/docs",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "pnpm run sync:examples && vitepress dev .",
        "build": "pnpm run sync:examples && pnpm run typedoc && vitepress build .",
        "preview": "vitepress preview .",
        "sync:examples": "node scripts/sync-examples.mjs",
        "typedoc": "typedoc --options typedoc.json"
    },
    "devDependencies": {
        "@select-box/example-react": "workspace:*",
        "@select-box/example-webcomponents": "workspace:*",
        "typedoc": "^0.28.4",
        "typedoc-plugin-markdown": "^4.4.0",
        "vitepress": "^1.5.0"
    }
}
