{
    "name": "@select-box/e2e",
    "version": "0.0.0",
    "private": true,
    "license": "MIT",
    "author": "giovani-freitag",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/giovani-freitag/select-box.git",
        "directory": "e2e"
    },
    "homepage": "https://giovani-freitag.github.io/select-box",
    "bugs": "https://github.com/giovani-freitag/select-box/issues",
    "description": "Matrix E2E suite: one spec set run against every wrapper in a real browser.",
    "type": "module",
    "scripts": {
        "e2e": "playwright test",
        "e2e:docs": "playwright test --config playwright.docs.config.ts",
        "e2e:headed": "playwright test --headed",
        "lint": "eslint specs docs-specs lib fixtures",
        "report": "playwright show-report",
        "typecheck": "vue-tsc --noEmit"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@select-box/eslint-config": "workspace:*",
        "@select-box/jquery": "workspace:*",
        "@select-box/lit": "workspace:*",
        "@select-box/react": "workspace:*",
        "@select-box/styles": "workspace:*",
        "@select-box/tsconfig": "workspace:*",
        "@select-box/vue": "workspace:*",
        "@select-box/webcomponents": "workspace:*",
        "@types/jquery": "^4.0.1",
        "@types/node": "^26.5.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "@vitejs/plugin-vue": "^6.0.8",
        "eslint": "^10.10.0",
        "jquery": "^4.0.0",
        "lit": "^3.3.3",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "typescript": "^5.9.3",
        "vite": "^8.2.2",
        "vue": "^3.5.42",
        "vue-tsc": "^2.2.12"
    }
}
