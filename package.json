{
    "name": "select-box",
    "version": "0.0.0",
    "private": true,
    "license": "UNLICENSED",
    "description": "Framework-agnostic combobox/select-box core and per-framework wrappers.",
    "type": "module",
    "engines": {
        "node": ">=20.10",
        "pnpm": ">=10"
    },
    "packageManager": "pnpm@11.0.9",
    "scripts": {
        "build": "turbo run build",
        "clean": "turbo run clean && rm -rf node_modules",
