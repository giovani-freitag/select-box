        "typecheck": "turbo run typecheck"
    },
    "devDependencies": {
        "@select-box/eslint-config": "workspace:*",
        "@types/node": "^26.4.0",
        "eslint": "^10.9.1",
        "turbo": "^2.10.12",
        "typescript": "^5.9.3"
    }
