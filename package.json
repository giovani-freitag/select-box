        "e2e:docs": "turbo run e2e:docs",
        "lint": "turbo run lint",
        "test": "turbo run test",
        "typecheck": "turbo run typecheck"
    },
    "devDependencies": {
        "@select-box/eslint-config": "workspace:*",
        "@types/node": "^22.10.2",
        "eslint": "^9.17.0",
        "turbo": "^2.3.3",
        "typescript": "^5.7.2"
    }
}
