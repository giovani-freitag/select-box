{
    "$schema": "https://typedoc.org/schema.json",
    "entryPoints": [
        "../packages/core/src/index.ts",
        "../packages/dom/src/index.ts",
        "../packages/react/src/index.ts",
        "../packages/lit/src/index.ts",
        "../packages/webcomponents/src/index.ts",
        "../packages/jquery/src/index.ts",
        "../packages/addon-clear-button/src/index.ts",
        "../packages/addon-create-option/src/index.ts",
        "../packages/addon-fuzzy/src/index.ts",
        "../packages/addon-hoist-selected/src/index.ts",
        "../packages/addon-persist/src/index.ts",
        "../packages/addon-remove-button/src/index.ts",
        "../packages/addon-restore-on-backspace/src/index.ts"
    ],
    "entryPointStrategy": "resolve",
    "out": "src/content/docs/api",
    "plugin": [
        "typedoc-plugin-markdown"
    ],
    "entryFileName": "index.md",
    "readme": "none",
    "githubPages": false,
    "hideGenerator": true,
    "excludePrivate": true,
    "excludeInternal": true,
    "excludeExternals": true,
    "tsconfig": "../tsconfig.typedoc.json",
    "externalSymbolLinkMappings": {
        "@tanstack/virtual-core": {
            "Virtualizer": "https://tanstack.com/virtual/latest/docs/api/virtualizer"
        }
    }
}
