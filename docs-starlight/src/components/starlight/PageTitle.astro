---
const { entry } = Astro.locals.starlightRoute;
const hideTitle = entry.data.template === "splash";
---

{hideTitle ? null : <h1 id="_top">{entry.data.title}</h1>}

<style>
    h1 {
        margin-top: 1rem;
        font-size: var(--sl-text-h1);
        line-height: var(--sl-line-height-headings);
        font-weight: 600;
        color: var(--sl-color-white);
    }
</style>
