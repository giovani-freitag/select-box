<!-- #region snippet -->
<div class="sb-demo">
    <select-box id="demo-search-static-wc" placeholder="Search fruits…"></select-box>
    <output id="demo-search-static-wc-out"><code>null</code></output>
</div>

<script>
    import "@select-box/webcomponents/define";
    import type { SelectBoxElement } from "@select-box/webcomponents";
    import { FuzzyFilterStrategy } from "@select-box/addon-fuzzy";

    const element = document.querySelector<SelectBoxElement>("#demo-search-static-wc")!;
    element.options = [
        { value: "apple", label: "Apple" },
        { value: "pear", label: "Pear" },
        { value: "peach", label: "Peach" },
        { value: "lemon", label: "Lemon" },
        { value: "blueberry", label: "Blueberry" },
        { value: "raspberry", label: "Raspberry" },
        { value: "strawberry", label: "Strawberry" },
        { value: "watermelon", label: "Watermelon" },
    ];
    element.filter = new FuzzyFilterStrategy();
    element.addEventListener("change", () => {
        const out = document.querySelector("#demo-search-static-wc-out code");
        if (out) out.textContent = element.selectedOption
            ? JSON.stringify(element.selectedOption)
            : "null";
    });
</script>
<!-- #endregion snippet -->
