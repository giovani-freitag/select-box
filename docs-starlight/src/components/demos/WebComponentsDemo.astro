---
const triggerId = `wc-demo-${Math.random().toString(36).slice(2, 9)}`;
const snapshotId = `${triggerId}-snapshot`;
---

<div class="sb-demo-card">
    <label class="sb-demo-label" for={triggerId}>Pick a fruit</label>
    <select-box id={triggerId} placeholder="Search fruits…" ungrouped-label="Citrus"></select-box>
    <dl class="sb-demo-snapshot">
        <dt>Last committed value</dt>
        <dd><code id={snapshotId}>null</code></dd>
    </dl>
</div>

<script>
    import "@select-box/webcomponents/define";
    import type { SelectBoxElement } from "@select-box/webcomponents";
    import { fruits, type Fruit } from "./fruits.ts";

    function initializeWebComponentsDemos(): void {
        const elements = document.querySelectorAll<SelectBoxElement<Fruit>>("select-box[id^='wc-demo-']");
        for (const element of elements) {
            if (element.dataset["bootstrapped"] === "true") continue;
            element.dataset["bootstrapped"] = "true";
            element.options = fruits;
            const snapshot = document.getElementById(`${element.id}-snapshot`);
            element.addEventListener("change", (event) => {
                const value = (event.target as SelectBoxElement<Fruit>).value;
                if (snapshot) snapshot.textContent = value ? JSON.stringify(value) : "null";
            });
        }
    }

    initializeWebComponentsDemos();
    document.addEventListener("astro:page-load", initializeWebComponentsDemos);
</script>
