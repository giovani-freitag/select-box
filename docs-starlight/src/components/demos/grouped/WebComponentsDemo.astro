<!-- #region snippet -->
<div class="sb-demo">
    <select-box
        id="demo-grouped-wc"
        placeholder="Pick a fruit"
        ungrouped-label="Citrus"
    ></select-box>
    <output id="demo-grouped-wc-out"><code>null</code></output>
</div>

<script>
    import "@select-box/webcomponents/define";
    import type { SelectBoxElement } from "@select-box/webcomponents";

    const element = document.querySelector<SelectBoxElement>("#demo-grouped-wc")!;
    element.options = [
        { value: "apple", label: "Apple", group: "Pomes" },
        { value: "pear", label: "Pear", group: "Pomes" },
        { value: "peach", label: "Peach", group: "Stone fruits" },
        { value: "plum", label: "Plum", group: "Stone fruits" },
        { value: "lemon", label: "Lemon" },
        { value: "orange", label: "Orange" },
    ];
    element.addEventListener("change", () => {
        const out = document.querySelector("#demo-grouped-wc-out code");
        if (out) out.textContent = element.selectedOption
            ? JSON.stringify(element.selectedOption)
            : "null";
    });
</script>
<!-- #endregion snippet -->
