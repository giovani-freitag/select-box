---
import { Code } from "@astrojs/starlight/components";
import FrameworkDemo from "../FrameworkDemo.astro";
import { extractSnippet } from "../extract-snippet.ts";
import ReactDemo from "./ReactDemo.tsx";
import VueDemo from "./VueDemo.vue";
import LitDemo from "./LitDemo.astro";
import WebComponentsDemo from "./WebComponentsDemo.astro";
import JqueryDemo from "./JqueryDemo.astro";

import reactSource from "./ReactDemo.tsx?raw";
import vueSource from "./VueDemo.vue?raw";
import litSource from "./LitDemo.astro?raw";
import webcomponentsSource from "./WebComponentsDemo.astro?raw";
import jquerySource from "./JqueryDemo.astro?raw";
---

<FrameworkDemo>
    <ReactDemo slot="react" client:only="react" />
    <VueDemo slot="vue" client:only="vue" />
    <LitDemo slot="lit" />
    <WebComponentsDemo slot="webcomponents" />
    <JqueryDemo slot="jquery" />

    <Code slot="react-code" code={extractSnippet(reactSource)} lang="tsx" />
    <Code slot="vue-code" code={extractSnippet(vueSource)} lang="vue" />
    <Code slot="lit-code" code={extractSnippet(litSource)} lang="astro" />
    <Code slot="webcomponents-code" code={extractSnippet(webcomponentsSource)} lang="astro" />
    <Code slot="jquery-code" code={extractSnippet(jquerySource)} lang="astro" />
</FrameworkDemo>
