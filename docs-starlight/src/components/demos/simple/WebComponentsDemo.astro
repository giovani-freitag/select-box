<!-- #region snippet -->
<div class="sb-demo">
    <select-box id="demo-simple-wc" placeholder="Pick a fruit"></select-box>
    <output id="demo-simple-wc-out"><code>null</code></output>
</div>

<script>
    import "@select-box/webcomponents/define";
    import type { SelectBoxElement } from "@select-box/webcomponents";

    const element = document.querySelector<SelectBoxElement>("#demo-simple-wc")!;
    element.options = [
        { value: "apple", label: "Apple" },
        { value: "pear", label: "Pear" },
        { value: "grape", label: "Grape" },
        { value: "lemon", label: "Lemon" },
        { value: "peach", label: "Peach" },
    ];
    element.addEventListener("change", () => {
        const out = document.querySelector("#demo-simple-wc-out code");
        if (out) out.textContent = element.selectedOption
            ? JSON.stringify(element.selectedOption)
            : "null";
    });
</script>
<!-- #endregion snippet -->
