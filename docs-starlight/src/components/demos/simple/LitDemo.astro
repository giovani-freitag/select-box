<!-- #region snippet -->
<div class="sb-demo">
    <select-box-lit id="demo-simple-lit" placeholder="Pick a fruit"></select-box-lit>
    <output id="demo-simple-lit-out"><code>null</code></output>
</div>

<script>
    import { SelectBox, defineSelectBoxElement } from "@select-box/lit";

    defineSelectBoxElement("select-box-lit");

    const element = document.querySelector<SelectBox>("#demo-simple-lit")!;
    element.options = [
        { value: "apple", label: "Apple" },
        { value: "pear", label: "Pear" },
        { value: "grape", label: "Grape" },
        { value: "lemon", label: "Lemon" },
        { value: "peach", label: "Peach" },
    ];
    element.addEventListener("change", () => {
        const out = document.querySelector("#demo-simple-lit-out code");
        if (out) out.textContent = element.selectedOption
            ? JSON.stringify(element.selectedOption)
            : "null";
    });
</script>
<!-- #endregion snippet -->
