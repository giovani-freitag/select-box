<!-- #region snippet -->
<div class="sb-demo">
    <div id="demo-simple-jq"></div>
    <output id="demo-simple-jq-out"><code>null</code></output>
</div>

<script>
    import jQuery from "jquery";
    import "@select-box/jquery";

    jQuery("#demo-simple-jq").on("change", (_event, value) => {
        const out = document.querySelector("#demo-simple-jq-out code");
        if (out) out.textContent = JSON.stringify(value);
    });

    jQuery("#demo-simple-jq").selectBox({
        options: [
            { value: "apple", label: "Apple" },
            { value: "pear", label: "Pear" },
            { value: "grape", label: "Grape" },
            { value: "lemon", label: "Lemon" },
            { value: "peach", label: "Peach" },
        ],
        placeholder: "Pick a fruit",
    });
</script>
<!-- #endregion snippet -->
