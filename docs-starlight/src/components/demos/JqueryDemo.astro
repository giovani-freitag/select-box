---
import type { Scenario } from "./fruits.js";

interface Props {
    scenario?: Scenario;
}

const { scenario = "grouped" } = Astro.props;
const triggerId = `jq-demo-${Math.random().toString(36).slice(2, 9)}`;
const snapshotId = `${triggerId}-snapshot`;
---

<div class="sb-demo-card">
    <label class="sb-demo-label" for={triggerId}>Pick a fruit</label>
    <div id={triggerId} data-scenario={scenario}></div>
    <dl class="sb-demo-snapshot">
        <dt>Last committed value</dt>
        <dd><code id={snapshotId}>null</code></dd>
    </dl>
</div>

<script>
    import jQuery from "jquery";
    import "@select-box/jquery";
    import { FuzzyFilterStrategy } from "@select-box/addon-fuzzy";
    import { SubstringFilterStrategy } from "@select-box/core";

    import {
        getFruitsForScenario,
        type Fruit,
        type FruitExtra,
        type Scenario,
    } from "./fruits.ts";

    const SUBSTRING_FILTER = new SubstringFilterStrategy<FruitExtra>();
    const FUZZY_FILTER = new FuzzyFilterStrategy<FruitExtra>();

    function initializeJqueryDemos(): void {
        const containers = document.querySelectorAll<HTMLElement>("[id^='jq-demo-']");
        for (const container of containers) {
            if (container.dataset["bootstrapped"] === "true") continue;
            if (container.tagName !== "DIV") continue;
            container.dataset["bootstrapped"] = "true";
            const scenario = (container.dataset["scenario"] ?? "grouped") as Scenario;
            const snapshot = document.getElementById(`${container.id}-snapshot`);
            const initialOptions =
                scenario === "large-list"
                    ? readBigListSeed()
                    : getFruitsForScenario(scenario);
            jQuery(container)
                .selectBox<FruitExtra>({
                    options: initialOptions as never,
                    ungroupedLabel: "Citrus",
                    placeholder:
                        scenario === "large-list" ? "Search the menagerie…" : "Search fruits…",
                })
                .on("change", (_event, _value: string | null, option: Fruit | null) => {
                    if (snapshot) snapshot.textContent = option ? JSON.stringify(option) : "null";
                });
            if (scenario === "search") {
                wireFilterToggle(container);
            }
            if (scenario === "large-list") {
                wireBigListSeed(container);
            }
        }
    }

    function wireFilterToggle(container: HTMLElement): void {
        window.addEventListener("filter-mode-changed", (event) => {
            const mode = (event as CustomEvent<{ mode: "substring" | "fuzzy" }>).detail.mode;
            const controller = jQuery(container).selectBox("controller");
            if (controller === undefined) return;
            controller.setFilter(mode === "fuzzy" ? FUZZY_FILTER : SUBSTRING_FILTER);
        });
    }

    function wireBigListSeed(container: HTMLElement): void {
        window.addEventListener("big-list-changed", (event) => {
            const detail = (event as CustomEvent<{ options: ReadonlyArray<unknown> }>).detail;
            // jQuery plugin doesn't take new options after init; tear down + rebuild.
            jQuery(container).selectBox("destroy");
            container.dataset["bootstrapped"] = "";
            jQuery(container).selectBox<FruitExtra>({
                options: detail.options as never,
                placeholder: "Search the menagerie…",
            });
            container.dataset["bootstrapped"] = "true";
        });
    }

    function readBigListSeed(): ReadonlyArray<unknown> {
        const value = window.__bigListSeed;
        return Array.isArray(value) ? value : [];
    }

    initializeJqueryDemos();
    document.addEventListener("astro:page-load", initializeJqueryDemos);
</script>
