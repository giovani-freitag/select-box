<!-- #region snippet -->
<div class="sb-demo">
    <div id="demo-inline-jq"></div>
    <output id="demo-inline-jq-out"><code>[]</code></output>
</div>

<script>
    import jQuery from "jquery";
    import "@select-box/jquery";

    jQuery("#demo-inline-jq").on("selectbox:change", (_event, values) => {
        const out = document.querySelector("#demo-inline-jq-out code");
        if (out) out.textContent = JSON.stringify(values);
    });

    jQuery("#demo-inline-jq").selectBox({
        mode: "multi",
        surface: "inline",
        options: [
            { value: "apple", label: "Apple" },
            { value: "pear", label: "Pear" },
            { value: "peach", label: "Peach" },
            { value: "plum", label: "Plum" },
            { value: "lemon", label: "Lemon" },
        ],
    });
</script>
<!-- #endregion snippet -->
