<!-- #region snippet -->
<div class="sb-demo">
    <select-box-lit
        id="demo-disabled-lit"
        placeholder="Pick a fruit"
        ungrouped-label="Citrus"
    ></select-box-lit>
    <output id="demo-disabled-lit-out"><code>null</code></output>
</div>

<script>
    import { SelectBox, defineSelectBoxElement } from "@select-box/lit";

    defineSelectBoxElement("select-box-lit");

    const element = document.querySelector<SelectBox>("#demo-disabled-lit")!;
    element.options = [
        { value: "apple", label: "Apple", group: "In stock" },
        { value: "pear", label: "Pear", group: "In stock" },
        { value: "grape", label: "Grape", group: "In stock", disabled: true },
        { value: "plum", label: "Plum", group: "Out of season", disabled: true },
        { value: "cherry", label: "Cherry", group: "Out of season", disabled: true },
        { value: "lemon", label: "Lemon" },
        { value: "orange", label: "Orange", disabled: true },
    ];
    element.addEventListener("change", () => {
        const out = document.querySelector("#demo-disabled-lit-out code");
        if (out) out.textContent = element.selectedOption
            ? JSON.stringify(element.selectedOption)
            : "null";
    });
</script>
<!-- #endregion snippet -->
