<!-- #region snippet -->
<div class="sb-demo">
    <div id="demo-disabled-jq"></div>
    <output id="demo-disabled-jq-out"><code>null</code></output>
</div>

<script>
    import jQuery from "jquery";
    import "@select-box/jquery";

    jQuery("#demo-disabled-jq")
        .selectBox({
            options: [
                { value: "apple", label: "Apple", group: "In stock" },
                { value: "pear", label: "Pear", group: "In stock" },
                { value: "grape", label: "Grape", group: "In stock", disabled: true },
                { value: "plum", label: "Plum", group: "Out of season", disabled: true },
                { value: "cherry", label: "Cherry", group: "Out of season", disabled: true },
                { value: "lemon", label: "Lemon" },
                { value: "orange", label: "Orange", disabled: true },
            ],
            ungroupedLabel: "Citrus",
            placeholder: "Pick a fruit",
        })
        .on("change", (_event, _value, option) => {
            const out = document.querySelector("#demo-disabled-jq-out code");
            if (out) out.textContent = option ? JSON.stringify(option) : "null";
        });
</script>
<!-- #endregion snippet -->
