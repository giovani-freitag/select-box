<!-- #region snippet -->
<div class="sb-demo">
    <label>
        Items:
        <strong id="demo-large-list-lit-count">1,000</strong>
        <input
            id="demo-large-list-lit-range"
            type="range"
            min="100"
            max="100000"
            step="100"
            value="1000"
        />
    </label>
    <select-box-lit id="demo-large-list-lit" placeholder="Search…"></select-box-lit>
</div>

<script>
    import { SelectBox, defineSelectBoxElement } from "@select-box/lit";

    defineSelectBoxElement("select-box-lit");

    function generate(count: number): ReadonlyArray<{ value: string; label: string }> {
        return Array.from({ length: count }, (_, index) => ({
            value: String(index),
            label: `Item ${index + 1}`,
        }));
    }

    const element = document.querySelector<SelectBox>("#demo-large-list-lit")!;
    element.options = generate(1000);

    document.querySelector<HTMLInputElement>("#demo-large-list-lit-range")!
        .addEventListener("change", function () {
            const count = Number(this.value);
            document.querySelector("#demo-large-list-lit-count")!.textContent = count.toLocaleString();
            element.options = generate(count);
        });
</script>
<!-- #endregion snippet -->
