<!-- #region snippet -->
<div class="sb-demo">
    <label>
        Items:
        <strong id="demo-large-list-wc-count">1,000</strong>
        <input
            id="demo-large-list-wc-range"
            type="range"
            min="100"
            max="100000"
            step="100"
            value="1000"
        />
    </label>
    <select-box id="demo-large-list-wc" placeholder="Search…"></select-box>
</div>

<script>
    import "@select-box/webcomponents/define";
    import type { SelectBoxElement } from "@select-box/webcomponents";

    function generate(count: number): ReadonlyArray<{ value: string; label: string }> {
        return Array.from({ length: count }, (_, index) => ({
            value: String(index),
            label: `Item ${index + 1}`,
        }));
    }

    const element = document.querySelector<SelectBoxElement>("#demo-large-list-wc")!;
    element.options = generate(1000);

    document.querySelector<HTMLInputElement>("#demo-large-list-wc-range")!
        .addEventListener("change", function () {
            const count = Number(this.value);
            document.querySelector("#demo-large-list-wc-count")!.textContent = count.toLocaleString();
            element.options = generate(count);
        });
</script>
<!-- #endregion snippet -->
