<!-- #region snippet -->
<div class="sb-demo">
    <label>
        Items:
        <strong id="demo-large-list-jq-count">1,000</strong>
        <input
            id="demo-large-list-jq-range"
            type="range"
            min="100"
            max="100000"
            step="100"
            value="1000"
        />
    </label>
    <div id="demo-large-list-jq"></div>
    <output id="demo-large-list-jq-out"><code>null</code></output>
</div>

<script>
    import jQuery from "jquery";
    import "@select-box/jquery";

    function generate(count: number): ReadonlyArray<{ value: string; label: string }> {
        return Array.from({ length: count }, (_, index) => ({
            value: String(index),
            label: `Item ${index + 1}`,
        }));
    }

    function mount(count: number): void {
        jQuery("#demo-large-list-jq")
            .selectBox({
                options: generate(count),
                placeholder: "Search…",
            })
            .on("change", (_event, _value, option) => {
                const out = document.querySelector("#demo-large-list-jq-out code");
                if (out) out.textContent = option?.label ?? "null";
            });
    }

    mount(1000);

    document.querySelector<HTMLInputElement>("#demo-large-list-jq-range")!
        .addEventListener("change", function () {
            const count = Number(this.value);
            document.querySelector("#demo-large-list-jq-count")!.textContent = count.toLocaleString();
            jQuery("#demo-large-list-jq").selectBox("destroy");
            mount(count);
        });
</script>
<!-- #endregion snippet -->
