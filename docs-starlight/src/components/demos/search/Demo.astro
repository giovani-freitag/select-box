---
import FrameworkDemo from "../FrameworkDemo.astro";
import Toggle from "./Toggle.astro";
import ReactDemo from "./ReactDemo.tsx";
import VueDemo from "./VueDemo.vue";
import LitDemo from "./LitDemo.astro";
import WebComponentsDemo from "./WebComponentsDemo.astro";
import JqueryDemo from "./JqueryDemo.astro";
---

<Toggle />
<FrameworkDemo>
    <ReactDemo slot="react" client:only="react" />
    <VueDemo slot="vue" client:only="vue" />
    <LitDemo slot="lit" />
    <WebComponentsDemo slot="webcomponents" />
    <JqueryDemo slot="jquery" />

    <slot name="react-code" slot="react-code" />
    <slot name="vue-code" slot="vue-code" />
    <slot name="lit-code" slot="lit-code" />
    <slot name="webcomponents-code" slot="webcomponents-code" />
    <slot name="jquery-code" slot="jquery-code" />
</FrameworkDemo>
