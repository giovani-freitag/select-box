---
// Page-level toggle that broadcasts the selected filter mode to every
// framework demo island via a `filter-mode-changed` CustomEvent on window.
---

<div class="sb-search-toggle not-content">
    <label class="sb-search-toggle-label">
        <input type="checkbox" id="sb-fuzzy-toggle" />
        <span>Use fuzzy search</span>
    </label>
</div>

<script>
    function wireFuzzyToggle(): void {
        const toggle = document.getElementById("sb-fuzzy-toggle");
        if (!(toggle instanceof HTMLInputElement)) return;
        if (toggle.dataset["wired"] === "true") return;
        toggle.dataset["wired"] = "true";
        toggle.addEventListener("change", () => {
            window.dispatchEvent(
                new CustomEvent("filter-mode-changed", {
                    detail: { mode: toggle.checked ? "fuzzy" : "substring" },
                }),
            );
        });
    }

    wireFuzzyToggle();
    document.addEventListener("astro:page-load", wireFuzzyToggle);
</script>

<style>
    .sb-search-toggle {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin: 1rem 0 1.5rem;
        padding: 0.75rem 1rem;
        border-radius: 8px;
        border: 1px solid var(--sl-color-hairline);
        background: var(--sl-color-bg-sidebar);
    }

    .sb-search-toggle-label {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
        cursor: pointer;
        user-select: none;
    }

    .sb-search-toggle-label input[type="checkbox"] {
        width: 1rem;
        height: 1rem;
        accent-color: var(--sl-color-accent);
        cursor: pointer;
    }
</style>
