---
const features = [
    {
        icon: "core",
        title: "One core, every wrapper",
        body: "SingleSelectBoxController owns state, search, virtualization and keyboard nav. Each wrapper is a thin adapter — zero framework logic in the core.",
    },
    {
        icon: "snapshot",
        title: "Same snapshot everywhere",
        body: "state.open, state.value, state.filteredGroups, state.activeIndex — identical fields across React, Vue, Lit, WC, jQuery. Tests assert against them directly.",
    },
    {
        icon: "matrix",
        title: "Matrix E2E suite",
        body: "A single Playwright spec runs against every framework's example. A core regression fails N times at once; a wrapper bug only fails its column.",
    },
    {
        icon: "addons",
        title: "Addons via declaration merging",
        body: "Opt into hoist-selected, clear-button, create-option via .use(). Snapshots extend through TypeScript module augmentation — typed, no casts.",
    },
    {
        icon: "headless",
        title: "Headless or ready",
        body: "Drop in the styled component for the common case, or grab useSelectBox() / the controller class and render whatever UI you need.",
    },
    {
        icon: "aria",
        title: "ARIA combobox spec",
        body: "Built against the WAI-ARIA combobox pattern. Keyboard navigation, focus management and aria-* attributes wired in the core, not patched per-framework.",
    },
];
---

<section class="sb-features not-content">
    <div class="sb-features-grid">
        {
            features.map((feature) => (
                <article class="sb-feature">
                    <div class={`sb-feature-icon sb-feature-icon-${feature.icon}`} aria-hidden="true">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            {feature.icon === "core" && (
                                <>
                                    <circle cx="12" cy="12" r="3" />
                                    <path d="M12 2v3M12 19v3M4.93 4.93l2.12 2.12M16.95 16.95l2.12 2.12M2 12h3M19 12h3M4.93 19.07l2.12-2.12M16.95 7.05l2.12-2.12" />
                                </>
                            )}
                            {feature.icon === "snapshot" && (
                                <>
                                    <rect x="3" y="4" width="18" height="16" rx="2" />
                                    <path d="M3 10h18M9 4v16" />
                                </>
                            )}
                            {feature.icon === "matrix" && (
                                <>
                                    <rect x="3" y="3" width="7" height="7" rx="1" />
                                    <rect x="14" y="3" width="7" height="7" rx="1" />
                                    <rect x="3" y="14" width="7" height="7" rx="1" />
                                    <rect x="14" y="14" width="7" height="7" rx="1" />
                                </>
                            )}
                            {feature.icon === "addons" && (
                                <>
                                    <path d="M12 2v20M2 12h20" />
                                    <circle cx="12" cy="12" r="9" />
                                </>
                            )}
                            {feature.icon === "headless" && (
                                <>
                                    <path d="M4 6h16M4 12h10M4 18h16" />
                                </>
                            )}
                            {feature.icon === "aria" && (
                                <>
                                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                                    <path d="M9 9h6M9 13h4" />
                                </>
                            )}
                        </svg>
                    </div>
                    <h3>{feature.title}</h3>
                    <p>{feature.body}</p>
                </article>
            ))
        }
    </div>
</section>

<style>
    .sb-features {
        padding: 3rem 1.25rem;
        max-width: 1180px;
        margin: 0 auto;
    }

    .sb-features-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1rem;
    }

    .sb-feature {
        position: relative;
        padding: 1.5rem;
        border-radius: 14px;
        border: 1px solid var(--sl-color-hairline);
        background: var(--sl-color-bg-sidebar);
        transition: border-color 0.2s ease, transform 0.2s ease;
    }

    .sb-feature:hover {
        border-color: color-mix(in srgb, var(--sl-color-accent) 35%, var(--sl-color-hairline));
        transform: translateY(-2px);
    }

    .sb-feature-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: var(--sb-brand-gradient-soft);
        color: var(--sl-color-text-accent);
        margin-bottom: 1rem;
    }

    .sb-feature h3 {
        margin: 0 0 0.5rem;
        font-size: 1.05rem;
        font-weight: 600;
        letter-spacing: -0.015em;
        color: var(--sl-color-white);
    }

    .sb-feature p {
        margin: 0;
        font-size: 0.92rem;
        line-height: 1.55;
        color: var(--sl-color-gray-2);
    }
</style>
