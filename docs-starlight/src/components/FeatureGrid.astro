---
const features = [
    {
        icon: "speed",
        title: "10,000 options, still smooth",
        body: "Drop in a huge list — only the rows on screen render. Search, scroll, pick — no lag, no manual virtualization to wire up.",
    },
    {
        icon: "search",
        title: "Search that just works",
        body: "Type to filter. Substring match by default, with matched characters highlighted in every row. One extra line swaps it for fuzzy matching.",
    },
    {
        icon: "a11y",
        title: "Keyboard and screen-reader ready",
        body: "Arrow keys, Enter, Escape, focus management, the full set of aria-* attributes — built to the WAI-ARIA combobox spec. Accessibility is the default, not a checklist for later.",
    },
    {
        icon: "form",
        title: "Plays nice with forms",
        body: "Submits inside a <form> like a native input. Works with React Hook Form, plain FormData, and the rest. No hidden inputs, no extra glue.",
    },
    {
        icon: "groups",
        title: "Grouped, disabled, optgroup-style",
        body: "Bundle options under group headers like native <optgroup>. Keyboard nav skips headers and disabled rows for you. Sticky headers when your CSS wants them.",
    },
    {
        icon: "headless",
        title: "Use ours, or render your own",
        body: "Drop in the styled component for the common case. Or take just the state and keyboard logic and render any UI you want — same package, same behaviour.",
    },
];
---

<section class="sb-features not-content">
    <div class="sb-features-grid">
        {
            features.map((feature) => (
                <article class="sb-feature">
                    <div class={`sb-feature-icon sb-feature-icon-${feature.icon}`} aria-hidden="true">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            {feature.icon === "speed" && (
                                <path d="M13 2 4 14h7l-1 8 9-12h-7l1-8z" />
                            )}
                            {feature.icon === "search" && (
                                <>
                                    <circle cx="11" cy="11" r="7" />
                                    <path d="m20 20-3.5-3.5" />
                                </>
                            )}
                            {feature.icon === "a11y" && (
                                <>
                                    <rect x="2" y="6" width="20" height="12" rx="2" />
                                    <path d="M6 10h.01M10 10h.01M14 10h.01M18 10h.01M7 14h10" />
                                </>
                            )}
                            {feature.icon === "form" && (
                                <>
                                    <rect x="3" y="4" width="18" height="16" rx="2" />
                                    <path d="m8 12 3 3 5-6" />
                                </>
                            )}
                            {feature.icon === "groups" && (
                                <>
                                    <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                                    <path d="M7 13h10" />
                                </>
                            )}
                            {feature.icon === "headless" && (
                                <>
                                    <path d="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z" />
                                </>
                            )}
                        </svg>
                    </div>
                    <h3>{feature.title}</h3>
                    <p>{feature.body}</p>
                </article>
            ))
        }
    </div>
</section>

<style>
    .sb-features {
        padding: 0;
    }

    .sb-features-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.25rem;
    }

    .sb-feature {
        position: relative;
        padding: 1.75rem 1.5rem;
        border-radius: 14px;
        border: 1px solid var(--sl-color-hairline);
        background: var(--sl-color-bg-sidebar);
        transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
        overflow: hidden;
        isolation: isolate;
    }

    .sb-feature::before {
        content: "";
        position: absolute;
        inset: 0 0 auto 0;
        height: 1px;
        background: linear-gradient(
            90deg,
            transparent,
            color-mix(in srgb, var(--sl-color-accent) 40%, transparent),
            transparent
        );
        opacity: 0;
        transition: opacity 0.2s ease;
    }

    .sb-feature:hover {
        border-color: color-mix(in srgb, var(--sl-color-accent) 45%, var(--sl-color-hairline));
        transform: translateY(-3px);
        box-shadow: 0 18px 40px -28px rgba(59, 130, 246, 0.45);
    }

    .sb-feature:hover::before {
        opacity: 1;
    }

    .sb-feature-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: var(--sb-brand-gradient-soft);
        color: var(--sl-color-text-accent);
        margin-bottom: 1.25rem;
        border: 1px solid color-mix(in srgb, var(--sl-color-accent) 20%, var(--sl-color-hairline));
    }

    .sb-feature h3 {
        margin: 0 0 0.5rem;
        font-size: 1.1rem;
        font-weight: 600;
        letter-spacing: -0.02em;
        color: var(--sl-color-white);
        line-height: 1.3;
    }

    .sb-feature p {
        margin: 0;
        font-size: 0.92rem;
        line-height: 1.6;
        color: var(--sl-color-gray-2);
    }
</style>
