---
interface Props {
    eyebrow?: string;
    title: string;
    titleHighlight?: string;
    tagline: string;
    primaryHref: string;
    primaryLabel: string;
    secondaryHref?: string;
    secondaryLabel?: string;
}

const {
    eyebrow = "v0.1 — pilot",
    title,
    titleHighlight,
    tagline,
    primaryHref,
    primaryLabel,
    secondaryHref,
    secondaryLabel,
} = Astro.props;
---

<section class="sb-hero not-content">
    <div class="sb-hero-bg" aria-hidden="true"></div>
    <div class="sb-hero-inner">
        {eyebrow ? <span class="sb-hero-eyebrow">{eyebrow}</span> : null}
        <h1 class="sb-hero-title">
            {title}
            {titleHighlight ? <span class="sb-grad-text">{titleHighlight}</span> : null}
        </h1>
        <p class="sb-hero-tagline">{tagline}</p>
        <div class="sb-hero-actions">
            <a class="sb-grad-btn" href={primaryHref}>
                {primaryLabel}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14"></path>
                    <path d="m12 5 7 7-7 7"></path>
                </svg>
            </a>
            {
                secondaryHref && secondaryLabel ? (
                    <a class="sb-ghost-btn" href={secondaryHref}>
                        {secondaryLabel}
                    </a>
                ) : null
            }
        </div>
        <slot name="footer" />
    </div>
</section>

<style>
    .sb-hero {
        position: relative;
        padding: clamp(3.5rem, 9vw, 7rem) 1.25rem clamp(2rem, 5vw, 4rem);
        text-align: center;
        overflow: hidden;
    }

    .sb-hero-bg {
        position: absolute;
        inset: -10% -10% 0 -10%;
        z-index: 0;
        background:
            radial-gradient(ellipse 50% 60% at 50% 0%, rgba(59, 130, 246, 0.18), transparent 70%),
            radial-gradient(ellipse 30% 40% at 80% 20%, rgba(168, 85, 247, 0.16), transparent 70%),
            radial-gradient(ellipse 30% 40% at 20% 30%, rgba(6, 182, 212, 0.14), transparent 70%);
        filter: blur(8px);
        pointer-events: none;
    }

    .sb-hero-bg::after {
        content: "";
        position: absolute;
        inset: 0;
        background-image:
            linear-gradient(rgba(148, 163, 184, 0.07) 1px, transparent 1px),
            linear-gradient(90deg, rgba(148, 163, 184, 0.07) 1px, transparent 1px);
        background-size: 36px 36px;
        mask-image: radial-gradient(ellipse 60% 60% at 50% 30%, #000 0%, transparent 70%);
        -webkit-mask-image: radial-gradient(ellipse 60% 60% at 50% 30%, #000 0%, transparent 70%);
    }

    .sb-hero-inner {
        position: relative;
        z-index: 1;
        max-width: 880px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.25rem;
    }

    .sb-hero-eyebrow {
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--sl-color-text-accent);
        padding: 0.35rem 0.75rem;
        border-radius: 999px;
        border: 1px solid var(--sl-color-accent-low);
        background: color-mix(in srgb, var(--sl-color-accent) 8%, transparent);
    }

    .sb-hero-title {
        font-size: clamp(2.5rem, 6vw, 4.5rem);
        line-height: 1.05;
        letter-spacing: -0.03em;
        font-weight: 800;
        margin: 0;
        max-width: 14ch;
    }

    .sb-hero-title .sb-grad-text {
        display: inline;
    }

    .sb-hero-tagline {
        margin: 0;
        font-size: clamp(1.05rem, 1.8vw, 1.25rem);
        line-height: 1.55;
        color: var(--sl-color-gray-2);
        max-width: 56ch;
    }

    .sb-hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        justify-content: center;
        margin-top: 0.5rem;
    }
</style>
