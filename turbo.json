{
    "$schema": "https://turbo.build/schema.json",
    "ui": "stream",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**", "dist/**/*", ".astro/**", "src/content/docs/api/**"]
        },
        "typecheck": {
            "dependsOn": ["^build"],
            "outputs": []
        },
        "test": {
            "dependsOn": ["^build"],
            "outputs": []
        },
        "e2e": {
            "dependsOn": ["^build"],
            "outputs": ["playwright-report/**", "test-results/**"],
            "cache": false
        },
        "lint": {
            "outputs": []
        },
        "clean": {
            "cache": false
        }
    }
}
