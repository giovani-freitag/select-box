{
    "name": "@select-box/jquery",
    "version": "0.1.0",
    "private": true,
    "license": "MIT",
    "author": "giovani-freitag",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/giovani-freitag/select-box.git",
        "directory": "packages/jquery"
    },
    "homepage": "https://giovani-freitag.github.io/select-box",
    "bugs": "https://github.com/giovani-freitag/select-box/issues",
    "keywords": [
        "select",
        "combobox",
        "jquery",
        "jquery-plugin"
    ],
    "description": "jQuery wrapper for the select-box library — registers $.fn.selectBox plugin.",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": [
        "./dist/index.js",
        "./dist/index.cjs"
    ],
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint src tests",
        "clean": "rm -rf dist .turbo"
    },
    "peerDependencies": {
        "@select-box/core": "workspace:*",
        "@select-box/dom": "workspace:*",
        "jquery": "^3.7.0"
    },
    "devDependencies": {
        "@select-box/core": "workspace:*",
        "@select-box/dom": "workspace:*",
        "@select-box/eslint-config": "workspace:*",
        "@select-box/parity": "workspace:*",
        "@select-box/tsconfig": "workspace:*",
        "@types/jquery": "^4.0.1",
        "eslint": "^10.8.1",
        "happy-dom": "^20.11.6",
        "jquery": "^4.0.0",
        "tsup": "^8.3.5",
        "typescript": "^7.0.2",
        "vitest": "^4.1.11"
    }
}
