{
    "name": "@select-box/jquery",
    "version": "0.0.0",
    "private": true,
    "description": "jQuery wrapper for the select-box combobox library — registers $.fn.selectBox plugin.",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": [
        "./dist/index.js",
        "./dist/index.cjs"
    ],
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint src tests",
        "clean": "rm -rf dist .turbo"
    },
    "peerDependencies": {
        "@select-box/core": "workspace:*",
        "jquery": "^3.7.0"
    },
    "devDependencies": {
        "@select-box/core": "workspace:*",
        "@select-box/eslint-config": "workspace:*",
        "@select-box/tsconfig": "workspace:*",
        "@types/jquery": "^3.5.32",
        "eslint": "^9.17.0",
        "happy-dom": "^15.11.7",
        "jquery": "^3.7.1",
        "tsup": "^8.3.5",
        "typescript": "^5.7.2",
        "vitest": "^2.1.8"
    }
}
