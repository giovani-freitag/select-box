{
    "name": "@select-box/jquery",
    "version": "0.2.0",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "author": "giovani-freitag",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/giovani-freitag/select-box.git",
        "directory": "packages/jquery"
    },
    "homepage": "https://giovani-freitag.github.io/select-box",
    "bugs": "https://github.com/giovani-freitag/select-box/issues",
    "keywords": [
        "select",
        "combobox",
        "jquery",
        "jquery-plugin"
    ],
    "description": "jQuery wrapper for the select-box library — registers $.fn.selectBox plugin.",
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist",
        "LICENSE"
    ],
    "sideEffects": [
        "./dist/index.js",
        "./dist/index.cjs"
    ],
    "scripts": {
        "build": "tsup",
        "check:packaging": "attw --pack . --profile node16 && publint --strict",
        "clean": "rm -rf dist .turbo",
        "lint": "eslint src tests",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit"
    },
    "peerDependencies": {
        "@select-box/core": "workspace:*",
        "@select-box/dom": "workspace:*",
        "jquery": "^3.7.0 || ^4.0.0"
    },
    "devDependencies": {
        "@select-box/core": "workspace:*",
        "@select-box/dom": "workspace:*",
        "@select-box/eslint-config": "workspace:*",
        "@select-box/parity": "workspace:*",
        "@select-box/tsconfig": "workspace:*",
        "@types/jquery": "^4.0.1",
        "eslint": "^10.9.1",
        "happy-dom": "^20.11.12",
        "jquery": "^4.0.0",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3",
        "vitest": "^4.1.11"
    }
}
