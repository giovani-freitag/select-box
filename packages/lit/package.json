{
    "name": "@select-box/lit",
    "version": "0.1.0",
    "private": true,
    "license": "MIT",
    "author": "giovani-freitag",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/giovani-freitag/select-box.git",
        "directory": "packages/lit"
    },
    "homepage": "https://giovani-freitag.github.io/select-box",
    "bugs": "https://github.com/giovani-freitag/select-box/issues",
    "keywords": [
        "select",
        "combobox",
        "lit",
        "web-components",
        "autocomplete"
    ],
    "description": "Lit wrapper for the select-box library — ready <SelectBox /> element + ReactiveController for composing custom LitElements.",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./define": {
            "types": "./dist/define.d.ts",
            "import": "./dist/define.js",
            "require": "./dist/define.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": [
        "./dist/define.js",
        "./dist/define.cjs"
    ],
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint src tests",
        "clean": "rm -rf dist .turbo"
    },
    "peerDependencies": {
        "@select-box/core": "workspace:*",
        "lit": "^3.2.0"
    },
    "devDependencies": {
        "@select-box/core": "workspace:*",
        "@select-box/eslint-config": "workspace:*",
        "@select-box/parity": "workspace:*",
        "@select-box/tsconfig": "workspace:*",
        "element-internals-polyfill": "^3.0.2",
        "eslint": "^10.8.1",
        "happy-dom": "^20.11.6",
        "jsdom": "^30.0.1",
        "lit": "^3.3.3",
        "tsup": "^8.3.5",
        "typescript": "^7.0.2",
        "vitest": "^4.1.11"
    }
}
