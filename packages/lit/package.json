{
    "name": "@select-box/lit",
    "version": "0.0.0",
    "private": true,
    "license": "UNLICENSED",
    "description": "Lit wrapper for the select-box library \u2014 ready <SelectBox /> element + ReactiveController for composing custom LitElements.",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./define": {
            "types": "./dist/define.d.ts",
            "import": "./dist/define.js",
            "require": "./dist/define.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": [
        "./dist/define.js",
        "./dist/define.cjs"
    ],
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint src tests",
        "clean": "rm -rf dist .turbo"
    },
    "peerDependencies": {
        "@select-box/core": "workspace:*",
        "lit": "^3.2.0"
    },
    "devDependencies": {
        "@select-box/core": "workspace:*",
        "@select-box/eslint-config": "workspace:*",
        "@select-box/parity": "workspace:*",
        "@select-box/tsconfig": "workspace:*",
        "eslint": "^9.17.0",
        "happy-dom": "^15.11.7",
        "jsdom": "^25.0.1",
        "lit": "^3.2.1",
        "tsup": "^8.3.5",
        "typescript": "^5.7.2",
        "vitest": "^2.1.8"
    }
}
