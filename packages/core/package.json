{
    "name": "@select-box/core",
    "version": "0.1.0",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "author": "giovani-freitag",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/giovani-freitag/select-box.git",
        "directory": "packages/core"
    },
    "homepage": "https://giovani-freitag.github.io/select-box",
    "bugs": "https://github.com/giovani-freitag/select-box/issues",
    "keywords": [
        "select",
        "combobox",
        "headless",
        "framework-agnostic",
        "autocomplete"
    ],
    "description": "Framework-agnostic core for the select-box library.",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint src tests",
        "clean": "rm -rf dist .turbo"
    },
    "devDependencies": {
        "@select-box/eslint-config": "workspace:*",
        "@select-box/tsconfig": "workspace:*",
        "eslint": "^9.39.5",
        "happy-dom": "^15.11.7",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3",
        "vitest": "^3.2.6"
    },
    "dependencies": {
        "@tanstack/virtual-core": "^3.17.8"
    }
}
