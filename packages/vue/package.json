{
    "name": "@select-box/vue",
    "version": "0.0.0",
    "private": true,
    "license": "UNLICENSED",
    "description": "Vue 3 wrapper for the select-box library.",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "vite build && vue-tsc --emitDeclarationOnly --project tsconfig.build.json",
        "typecheck": "vue-tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint src tests",
        "clean": "rm -rf dist .turbo"
    },
    "peerDependencies": {
        "@select-box/core": "workspace:*",
        "vue": "^3.5.0"
    },
    "devDependencies": {
        "@select-box/core": "workspace:*",
        "@select-box/eslint-config": "workspace:*",
        "@select-box/tsconfig": "workspace:*",
        "@vitejs/plugin-vue": "^5.2.1",
        "@vue/test-utils": "^2.4.6",
        "eslint": "^9.17.0",
        "happy-dom": "^15.11.7",
        "typescript": "^5.7.2",
        "vite": "^6.0.5",
        "vitest": "^2.1.8",
        "vue": "^3.5.13",
        "vue-tsc": "^2.2.0"
    }
}
