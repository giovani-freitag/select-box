{
    "name": "@select-box/vue",
    "version": "0.1.0",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "author": "giovani-freitag",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/giovani-freitag/select-box.git",
        "directory": "packages/vue"
    },
    "homepage": "https://giovani-freitag.github.io/select-box",
    "bugs": "https://github.com/giovani-freitag/select-box/issues",
    "keywords": [
        "select",
        "combobox",
        "vue",
        "vue3",
        "autocomplete"
    ],
    "description": "Vue 3 wrapper for the select-box library.",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "vite build && vue-tsc --emitDeclarationOnly --project tsconfig.build.json",
        "typecheck": "vue-tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint src tests",
        "clean": "rm -rf dist .turbo"
    },
    "peerDependencies": {
        "@select-box/core": "workspace:*",
        "vue": "^3.5.0"
    },
    "devDependencies": {
        "@select-box/core": "workspace:*",
        "@select-box/eslint-config": "workspace:*",
        "@select-box/parity": "workspace:*",
        "@select-box/tsconfig": "workspace:*",
        "@vitejs/plugin-vue": "^5.2.4",
        "@vue/test-utils": "^2.4.11",
        "eslint": "^9.39.5",
        "happy-dom": "^15.11.7",
        "typescript": "^5.9.3",
        "vite": "^6.4.3",
        "vitest": "^3.2.6",
        "vue": "^3.5.41",
        "vue-tsc": "^2.2.12"
    }
}
