{
    "name": "@select-box/vue",
    "version": "0.1.0",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "author": "giovani-freitag",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/giovani-freitag/select-box.git",
        "directory": "packages/vue"
    },
    "homepage": "https://giovani-freitag.github.io/select-box",
    "bugs": "https://github.com/giovani-freitag/select-box/issues",
    "keywords": [
        "select",
        "combobox",
        "vue",
        "vue3",
        "autocomplete"
    ],
    "description": "Vue 3 wrapper for the select-box library.",
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist",
        "LICENSE"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "vite build && vue-tsc --emitDeclarationOnly --project tsconfig.build.json && node scripts/emit-cjs-types.mjs",
        "check:packaging": "attw --pack . --profile node16 && publint --strict",
        "clean": "rm -rf dist .turbo",
        "lint": "eslint src tests",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "vue-tsc --noEmit"
    },
    "peerDependencies": {
        "@select-box/core": "workspace:*",
        "vue": "^3.5.0"
    },
    "devDependencies": {
        "@select-box/core": "workspace:*",
        "@select-box/eslint-config": "workspace:*",
        "@select-box/parity": "workspace:*",
        "@select-box/tsconfig": "workspace:*",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vue/test-utils": "^2.5.0",
        "eslint": "^10.9.1",
        "happy-dom": "^20.11.12",
        "typescript": "^5.9.3",
        "vite": "^8.2.2",
        "vitest": "^4.1.11",
        "vue": "^3.5.42",
        "vue-tsc": "^3.3.11"
    }
}
