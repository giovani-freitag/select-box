{
    "name": "@select-box/webcomponents",
    "version": "0.1.0",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "author": "giovani-freitag",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/giovani-freitag/select-box.git",
        "directory": "packages/webcomponents"
    },
    "homepage": "https://giovani-freitag.github.io/select-box",
    "bugs": "https://github.com/giovani-freitag/select-box/issues",
    "keywords": [
        "select",
        "combobox",
        "web-components",
        "custom-elements"
    ],
    "description": "Web Components wrapper for the select-box library — exports SelectBoxElement and defineSelectBoxElement.",
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./define": {
            "import": {
                "types": "./dist/define.d.ts",
                "default": "./dist/define.js"
            },
            "require": {
                "types": "./dist/define.d.cts",
                "default": "./dist/define.cjs"
            }
        }
    },
    "typesVersions": {
        "*": {
            "define": [
                "./dist/define.d.ts"
            ]
        }
    },
    "files": [
        "dist",
        "LICENSE"
    ],
    "sideEffects": [
        "./dist/define.js",
        "./dist/define.cjs"
    ],
    "scripts": {
        "build": "tsup",
        "check:packaging": "attw --pack . --profile node16 && publint --strict",
        "clean": "rm -rf dist .turbo",
        "lint": "eslint src tests",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit"
    },
    "peerDependencies": {
        "@select-box/core": "workspace:*",
        "@select-box/dom": "workspace:*"
    },
    "devDependencies": {
        "@select-box/core": "workspace:*",
        "@select-box/dom": "workspace:*",
        "@select-box/eslint-config": "workspace:*",
        "@select-box/parity": "workspace:*",
        "@select-box/tsconfig": "workspace:*",
        "element-internals-polyfill": "^3.0.2",
        "eslint": "^10.9.1",
        "happy-dom": "20.3.2",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3",
        "vitest": "^4.1.11"
    }
}
