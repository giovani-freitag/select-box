{
    "name": "@select-box/dom",
    "version": "0.1.0",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "author": "giovani-freitag",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/giovani-freitag/select-box.git",
        "directory": "packages/dom"
    },
    "homepage": "https://giovani-freitag.github.io/select-box",
    "bugs": "https://github.com/giovani-freitag/select-box/issues",
    "keywords": [
        "select",
        "combobox",
        "dom",
        "renderer"
    ],
    "description": "Imperative light-DOM painters shared by the wrappers that build their own markup (jQuery, web components).",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint src tests",
        "clean": "rm -rf dist .turbo"
    },
    "peerDependencies": {
        "@select-box/core": "workspace:*"
    },
    "devDependencies": {
        "@select-box/core": "workspace:*",
        "@select-box/eslint-config": "workspace:*",
        "@select-box/tsconfig": "workspace:*",
        "eslint": "^10.9.1",
        "happy-dom": "^20.11.12",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3",
        "vitest": "^4.1.11"
    }
}
